          "default": 100,
          "type": "px",
          "description": "Activation radius"
        }
      },
      "code": {
        "js": "document.querySelectorAll(\"[data-fx=\\\"magnetic\\\"]\").forEach(el=>{const STR=0.3,PROX=100;el.style.transition=\"transform 200ms ease-out\";document.addEventListener(\"mousemove\",e=>{const r=el.getBoundingClientRect();const cx=r.left+r.width/2,cy=r.top+r.height/2;const dx=e.clientX-cx,dy=e.clientY-cy;const d=Math.hypot(dx,dy);if(d<PROX){el.style.transform=`translate(${dx*STR}px,${dy*STR}px)`}else{el.style.transform=\"translate(0,0)\"}})});"
      },
