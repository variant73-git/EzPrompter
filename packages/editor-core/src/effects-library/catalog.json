    {
      "id": "blur-text-word",
      "name": "Blur Text Word",
      "category": "reveal",
      "description": "Word-by-word blur reveal on viewport entry. Text starts blurred and translated, settles into place per-word with stagger. Signature motionsites/Aceternity-style entrance for hero headlines.",
      "params": {
        "stagger": {
          "default": 100,
          "type": "ms",
          "description": "Delay between consecutive words"
        },
        "duration": {
          "default": 700,
          "type": "ms",
          "description": "Per-word transition duration"
        },
        "blurAmount": {
          "default": 10,
          "type": "px",
          "description": "Initial blur radius"
        }
      },
      "code": {
        "js": "const elements=document.querySelectorAll(\"[data-fx=\\\"blur-text-word\\\"]\");elements.forEach(el=>{const text=el.textContent.trim();el.innerHTML=\"\";const words=text.split(/\\\\s+/);words.forEach((w,i)=>{const span=document.createElement(\"span\");span.textContent=w;span.style.cssText=\"display:inline-block;margin-right:0.28em;opacity:0;filter:blur(10px);transform:translateY(20px);transition:opacity 700ms ease-out,filter 700ms ease-out,transform 700ms ease-out;\";span.dataset.delay=i*100;el.appendChild(span)});const obs=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.querySelectorAll(\"span\").forEach(s=>{setTimeout(()=>{s.style.opacity=\"1\";s.style.filter=\"blur(0)\";s.style.transform=\"translateY(0)\"},Number(s.dataset.delay))});obs.unobserve(entry.target)}})},{threshold:0.3});obs.observe(el)});"
      },
      "source": "motionsites.ai BlurText (curated, vanilla-rewritten from Framer Motion original)",
      "appliesTo": [
        "hero-headline",
        "h1",
        "h2"
      ]
    },
    {
      "id": "fade-up-stagger",
      "name": "Fade Up Stagger",
      "category": "reveal",
      "description": "Group of children fade up with index-based delay on viewport entry. Standard editorial reveal pattern.",
      "params": {
        "delays": {
          "default": [
            0,
            150,
            300,
            450
          ],
          "type": "ms[]",
          "description": "Per-child delays"
        },
        "duration": {
          "default": 800,
          "type": "ms"
        },
        "offset": {
          "default": 20,
          "type": "px",
          "description": "Initial translateY"
        }
      },
      "code": {
        "css": "[data-fx=\"fade-up-stagger\"]>*{opacity:0;transform:translateY(20px);transition:opacity 800ms ease-out,transform 800ms ease-out}[data-fx=\"fade-up-stagger\"].in>*{opacity:1;transform:translateY(0)}",
        "js": "const groups=document.querySelectorAll(\"[data-fx=\\\"fade-up-stagger\\\"]\");groups.forEach(g=>{Array.from(g.children).forEach((c,i)=>c.style.transitionDelay=`${i*150}ms`);const obs=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add(\"in\");obs.unobserve(entry.target)}})},{threshold:0.3});obs.observe(g)});"
      },
      "source": "Framer Motion stagger pattern (curated, vanilla)",
      "appliesTo": [
        "section",
        "grid",
        "list"
      ]
    },
    {
      "id": "scale-in-on-view",
      "name": "Scale In On View",
      "category": "reveal",
      "description": "Element scales from 0.8 to 1 with opacity fade-in when entering viewport. Soft, gentle entrance.",
      "params": {
        "duration": {
          "default": 900,
          "type": "ms"
        },
        "fromScale": {
          "default": 0.8,
          "type": "number"
        },
        "easing": {
          "default": "cubic-bezier(0.2, 0.8, 0.2, 1)",
          "type": "easing"
        }
      },
      "code": {
        "css": "[data-fx=\"scale-in\"]{opacity:0;transform:scale(0.8);transition:opacity 900ms cubic-bezier(0.2,0.8,0.2,1),transform 900ms cubic-bezier(0.2,0.8,0.2,1)}[data-fx=\"scale-in\"].in{opacity:1;transform:scale(1)}",
        "js": "const obs=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add(\"in\");obs.unobserve(entry.target)}}),{threshold:0.3});document.querySelectorAll(\"[data-fx=\\\"scale-in\\\"]\").forEach(el=>obs.observe(el));"
      },
      "source": "Generic Framer Motion scale-in pattern",
      "appliesTo": [
        "card",
        "image",
        "media-block"
      ]
    },
