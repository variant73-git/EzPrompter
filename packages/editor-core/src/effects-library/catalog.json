      },
      "code": {
        "js": "const els=document.querySelectorAll(\"[data-fx=\\\"parallax\\\"]\");let raf=null;function update(){els.forEach(el=>{const r=el.getBoundingClientRect();const center=r.top+r.height/2-window.innerHeight/2;el.style.transform=`translateY(${center*-0.3}px)`});raf=null}window.addEventListener(\"scroll\",()=>{if(!raf)raf=requestAnimationFrame(update)},{passive:true});update();"
