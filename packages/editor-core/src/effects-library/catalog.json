    {
      "id": "hover-tilt",
      "name": "Hover Tilt",
      "category": "interaction",
      "description": "3D perspective tilt following cursor over the element. Subtle, no excessive rotation. For cards and feature blocks.",
      "params": {
        "maxRotate": {
          "default": 8,
          "type": "degrees"
        },
        "perspective": {
          "default": 1000,
          "type": "px"
        }
      },
      "code": {
        "js": "document.querySelectorAll(\"[data-fx=\\\"hover-tilt\\\"]\").forEach(el=>{const MAX=8;el.style.transformStyle=\"preserve-3d\";el.style.transition=\"transform 200ms ease-out\";el.addEventListener(\"mousemove\",e=>{const r=el.getBoundingClientRect();const px=(e.clientX-r.left)/r.width-0.5;const py=(e.clientY-r.top)/r.height-0.5;el.style.transform=`perspective(1000px) rotateY(${px*MAX}deg) rotateX(${-py*MAX}deg)`});el.addEventListener(\"mouseleave\",()=>{el.style.transform=\"perspective(1000px) rotateY(0) rotateX(0)\"})});"
      },
      "source": "vanilla-tilt.js pattern (curated, simplified)",
      "appliesTo": [
        "card",
        "feature-block",
        "image-frame"
      ]
    },
    {
      "id": "count-up-on-view",
      "name": "Count Up On View",
      "category": "interaction",
      "description": "Number counter animates from 0 to a target value when the element enters viewport. Configurable easing and duration.",
      "params": {
        "duration": {
          "default": 2400,
          "type": "ms"
        },
        "easing": {
          "default": "easeOutExpo",
          "type": "easing",
          "values": [
            "linear",
            "easeOutExpo",
            "easeOutQuart"
          ]
        }
      },
      "code": {
        "js": "const ease={linear:t=>t,easeOutExpo:t=>t===1?1:1-Math.pow(2,-10*t),easeOutQuart:t=>1-Math.pow(1-t,4)};const obs=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){const el=entry.target;const target=parseFloat(el.dataset.target);const dur=Number(el.dataset.duration||2400);const fn=ease[el.dataset.easing||\"easeOutExpo\"];const start=performance.now();function step(now){const p=Math.min((now-start)/dur,1);const v=fn(p)*target;el.textContent=target%1===0?Math.floor(v).toLocaleString():v.toFixed(1);if(p<1)requestAnimationFrame(step)}requestAnimationFrame(step);obs.unobserve(el)}}),{threshold:0.5});document.querySelectorAll(\"[data-fx=\\\"count-up\\\"]\").forEach(el=>obs.observe(el));"
      },
      "source": "Generic count-up pattern (Cambrian.com observed; widely used)",
      "appliesTo": [
        "stat-number",
        "hero-metric"
      ]
    },
    {
