    {
      "id": "dot-matrix-canvas",
      "name": "Dot Matrix Canvas",
      "category": "background",
      "description": "Slow-breathing grid of small dots rendered on a canvas. Subtle technical/atmospheric backdrop. Pointer-reactive drift optional.",
      "params": {
        "density": {
          "default": 0.3,
          "type": "number",
          "description": "Dots per 10px squared"
        },
        "breathe": {
          "default": 4000,
          "type": "ms",
          "description": "Pulse cycle duration"
        },
        "color": {
          "default": "rgba(255,255,255,0.3)",
          "type": "color"
        }
      },
      "code": {
        "js": "const canvases=document.querySelectorAll(\"canvas[data-fx=\\\"dot-matrix\\\"]\");canvases.forEach(canvas=>{const ctx=canvas.getContext(\"2d\");const fit=()=>{canvas.width=canvas.clientWidth;canvas.height=canvas.clientHeight};fit();window.addEventListener(\"resize\",fit);const color=canvas.dataset.color||\"rgba(255,255,255,0.3)\";const spacing=20;let t=0;function frame(){t+=0.016;ctx.clearRect(0,0,canvas.width,canvas.height);const pulse=0.5+0.5*Math.sin(t*Math.PI*2/4);for(let x=spacing/2;x<canvas.width;x+=spacing){for(let y=spacing/2;y<canvas.height;y+=spacing){const dist=Math.hypot(x-canvas.width/2,y-canvas.height/2);const fade=Math.max(0,1-dist/(canvas.width/1.5));ctx.fillStyle=color;ctx.globalAlpha=pulse*fade*0.6;ctx.beginPath();ctx.arc(x,y,1.5,0,Math.PI*2);ctx.fill()}}requestAnimationFrame(frame)}requestAnimationFrame(frame)});"
      },
      "source": "Aura.build / neuform WebGL recipe (curated as 2D canvas equivalent)",
      "appliesTo": [
        "section-hero-bg",
        "section-cta-bg"
      ]
    },
    {
      "id": "gradient-mesh-animated",
