    "fill": "Animated gradients and patterns for backgrounds and text-fill",
    "reveal": "Entrance animations triggered on scroll or load",
    "surface": "Material treatments (glass, gradient borders, frosted overlays)",
    "background": "Section-level decorative canvas/SVG backgrounds",
    "interaction": "Pointer/hover/cursor-driven micro-interactions",
    "layout": "Scroll-driven layout primitives (sticky, marquee, parallax)"
  },
