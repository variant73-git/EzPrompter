      "code": {
        "css": "[data-fx=\"split-grid\"]>*:nth-child(odd){opacity:0;transform:translateX(-60px);transition:opacity 900ms ease-out,transform 900ms ease-out}[data-fx=\"split-grid\"]>*:nth-child(even){opacity:0;transform:translateX(60px);transition:opacity 900ms ease-out,transform 900ms ease-out}[data-fx=\"split-grid\"].in>*{opacity:1;transform:translateX(0)}",
