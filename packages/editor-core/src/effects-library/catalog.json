    {
      "id": "particles",
      "name": "Particles",
      "category": "background",
      "description": "Field of small floating particles drifting upward, rendered on canvas. Suggests motion, dust, atmosphere.",
      "params": {
        "count": {
          "default": 60,
          "type": "integer"
        },
        "speed": {
          "default": 0.5,
          "type": "px/frame"
        },
        "color": {
          "default": "rgba(255,255,255,0.4)",
          "type": "color"
        }
      },
      "code": {
        "js": "const canvases=document.querySelectorAll(\"canvas[data-fx=\\\"particles\\\"]\");canvases.forEach(canvas=>{const ctx=canvas.getContext(\"2d\");const fit=()=>{canvas.width=canvas.clientWidth;canvas.height=canvas.clientHeight};fit();window.addEventListener(\"resize\",fit);const color=canvas.dataset.color||\"rgba(255,255,255,0.4)\";const N=60;const parts=Array.from({length:N},()=>({x:Math.random()*canvas.width,y:Math.random()*canvas.height,r:0.5+Math.random()*1.5,vy:0.3+Math.random()*0.8,vx:(Math.random()-0.5)*0.2,a:0.3+Math.random()*0.5}));function frame(){ctx.clearRect(0,0,canvas.width,canvas.height);parts.forEach(p=>{p.y-=p.vy;p.x+=p.vx;if(p.y<-5)p.y=canvas.height+5;if(p.x<-5)p.x=canvas.width+5;if(p.x>canvas.width+5)p.x=-5;ctx.fillStyle=color;ctx.globalAlpha=p.a;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill()});requestAnimationFrame(frame)}requestAnimationFrame(frame)});"
      },
      "source": "Generic canvas particles (curated, lightweight rewrite)",
      "appliesTo": [
        "section-hero-bg",
        "footer-bg"
      ]
    },
    {
      "id": "video-loop-fade",
      "name": "Video Loop Fade",
      "category": "background",
      "description": "Background video that crossfades into itself near the end and on load. Avoids abrupt loop cuts. rAF-driven, no CSS transition.",
      "params": {
        "fadeMs": {
          "default": 500,
          "type": "ms",
          "description": "Crossfade duration"
        },
        "fadeOutLead": {
          "default": 0.55,
          "type": "seconds",
          "description": "Trigger fade-out N seconds before end"
        }
      },
      "code": {
        "js": "document.querySelectorAll(\"video[data-fx=\\\"video-loop-fade\\\"]\").forEach(v=>{const FADE=500,LEAD=0.55;v.style.opacity=\"0\";v.removeAttribute(\"loop\");let raf=null,fadingOut=false;function fadeTo(target,dur){if(raf)cancelAnimationFrame(raf);const start=performance.now(),from=parseFloat(v.style.opacity)||0;function step(now){const p=Math.min((now-start)/dur,1);v.style.opacity=String(from+(target-from)*p);if(p<1)raf=requestAnimationFrame(step)}raf=requestAnimationFrame(step)}v.addEventListener(\"loadeddata\",()=>{v.style.opacity=\"0\";v.play();fadeTo(1,FADE)});v.addEventListener(\"timeupdate\",()=>{if(!fadingOut&&v.duration-v.currentTime<=LEAD&&v.duration-v.currentTime>0){fadingOut=true;fadeTo(0,FADE)}});v.addEventListener(\"ended\",()=>{v.style.opacity=\"0\";setTimeout(()=>{v.currentTime=0;v.play();fadingOut=false;fadeTo(1,FADE)},100)})});"
      },
      "source": "motionsites.ai FadingVideo component (curated, exact behavior)",
      "appliesTo": [
        "section-hero-bg"
      ]
    },
    {
      "id": "aurora-canvas",
      "name": "Aurora Canvas",
      "category": "background",
      "description": "Flowing aurora-like waves of color rendered on canvas with low-frequency sine motion. Different from the CSS Aurora — full-canvas wide motion, suitable for hero backgrounds.",
      "params": {
        "colors": {
          "default": [
            "#4f46e5",
            "#7c3aed",
            "#ec4899"
          ],
          "type": "color[]"
        },
        "speed": {
          "default": 0.0008,
          "type": "rate"
        }
      },
      "code": {
        "js": "document.querySelectorAll(\"canvas[data-fx=\\\"aurora-canvas\\\"]\").forEach(canvas=>{const ctx=canvas.getContext(\"2d\");const fit=()=>{canvas.width=canvas.clientWidth;canvas.height=canvas.clientHeight};fit();window.addEventListener(\"resize\",fit);const colors=[\"#4f46e5\",\"#7c3aed\",\"#ec4899\"];let t=0;function frame(){t+=0.0008;ctx.clearRect(0,0,canvas.width,canvas.height);colors.forEach((c,i)=>{const cx=canvas.width*(0.3+0.4*Math.sin(t*1000*(i+1)*0.5));const cy=canvas.height*(0.4+0.3*Math.cos(t*1000*(i+1)*0.7));const grad=ctx.createRadialGradient(cx,cy,0,cx,cy,canvas.width*0.6);grad.addColorStop(0,c+\"66\");grad.addColorStop(1,c+\"00\");ctx.fillStyle=grad;ctx.fillRect(0,0,canvas.width,canvas.height)});requestAnimationFrame(frame)}requestAnimationFrame(frame)});"
      },
      "source": "Aceternity UI Aurora pattern (curated, vanilla canvas rewrite)",
      "appliesTo": [
        "section-hero-bg",
        "splash-overlay"
      ]
    },
    {
      "id": "magnetic-cursor",
      "name": "Magnetic Cursor",
      "category": "interaction",
      "description": "Element subtly attracts toward the cursor when within proximity. CTAs that feel alive without being aggressive.",
      "params": {
        "strength": {
          "default": 0.3,
          "type": "number",
          "description": "Translate ratio (0-1)"
        },
