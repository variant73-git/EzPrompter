        "js": "document.querySelectorAll(\"[data-fx=\\\"rotating-headlines\\\"]\").forEach(el=>{let seq;try{seq=JSON.parse(el.dataset.headlines||\"[]\")}catch{seq=[]}if(!seq.length)return;let i=0;el.style.transition=\"opacity \"+(el.dataset.transitionMs||600)+\"ms ease\";el.textContent=seq[0];const cycleMs=Number(el.dataset.cycleMs||4000);setInterval(()=>{el.style.opacity=\"0\";setTimeout(()=>{i=(i+1)%seq.length;el.textContent=seq[i];el.style.opacity=\"1\"},Number(el.dataset.transitionMs||600))},cycleMs)});"
      },
