      "code": {
        "css": "[data-fx=\"marquee-x\"]{overflow:hidden;display:flex;mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)}[data-fx=\"marquee-x\"]>.marquee-track{display:flex;flex-shrink:0;animation:rb-fx-marquee-x 30s linear infinite}@keyframes rb-fx-marquee-x{from{transform:translateX(0)}to{transform:translateX(-50%)}}",
