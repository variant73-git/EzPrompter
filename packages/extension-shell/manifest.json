{
  "manifest_version": 3,
  "name": "Uncraft",
  "version": "2.5.0",
  "description": "Uncraft — design tool for the web. Edit any site visually with AI rebuild + design-tool ergonomics, in your browser.",
  "permissions": [
    "contextMenus",
    "storage",
    "downloads",
    "activeTab",
    "tabs",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.stability.ai/*",
    "https://api.replicate.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Send this tab to Uncraft"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles/content.css"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["handoff/capture.js", "handoff/handoff.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3030/*",
        "http://127.0.0.1:3030/*",
        "https://*.uncraft.app/*",
        "https://uncraft.app/*",
        "https://*.vercel.app/*"
      ],
      "js": ["handoff/present-flag.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["editor/editor.css", "editor/editor.js", "editor/rebuild.js", "editor/detect.js", "editor/freeze.js", "editor/mode-e.js", "editor/mode-e-classic.js", "editor/mode-e-diff.js", "editor/mode-e-refine.js", "editor/mode-b.js", "editor/mode-e2.js", "editor/s2h.js", "editor/persist.js", "editor/fill-popup.js", "editor/extractor.js", "editor/test-minimal.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
