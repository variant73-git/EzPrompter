DATABASE_URL=postgresql://...
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
UNCRAFT_NATIVE_BUNDLE_STORE_ROOT=.native-bundles
UPSTASH_REDIS_REST_URL=...
UPSTASH_REDIS_REST_TOKEN=...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
JWT_SECRET=your-random-secret-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dedicated, short-lived read-only runtime sessions. Never reuse JWT_SECRET.
UNCRAFT_RUNTIME_SESSION_SECRET=another-random-secret-with-at-least-32-characters
# Required in production and must be a separate HTTPS origin with no app cookie scope.
UNCRAFT_RUNTIME_ORIGIN=https://runtime.example.com

# Local native-clone bundle used by the isolated motion-editor prototype.
# Point at a built folder containing index.html and its localized assets.
UNCRAFT_NATIVE_CLONE_ROOT=/absolute/path/to/native-clone/dist
