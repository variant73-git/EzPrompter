{
  "name": "@uncraft/web-shell",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "rm -rf .next && (lsof -ti:3030 | xargs kill -9 2>/dev/null || true)",
    "dev": "next dev --port 3030",
    "dev:keep": "next dev --port 3030",
    "build": "next build",
    "start": "next start --port 3030",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "evals:gen": "node evals/gen-prompt.mjs",
    "evals": "node evals/gen-prompt.mjs && promptfoo eval -c evals/promptfooconfig.yaml",
    "evals:view": "promptfoo view"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@google/genai": "latest",
    "@neondatabase/serverless": "^0.10",
    "@uncraft/editor-core": "*",
    "@upstash/redis": "^1.34",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.2",
    "langfuse": "^3.38.20",
    "linkedom": "^0.18.0",
    "next": "^15",
    "openai": "^6.37.0",
    "opossum": "^9.0.0",
    "playwright-core": "^1.50.0",
    "react": "^19",
    "react-dom": "^19",
    "react-zoom-pan-pinch": "^3.6.0",
    "stripe": "^17"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "promptfoo": "^0.121.15",
    "tailwindcss": "^4.3.0",
    "vitest": "^4.1.7"
  }
}
