{
  "name": "@uncraft/web-shell",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "rm -rf .next && (lsof -ti:3030 | xargs kill -9 2>/dev/null || true)",
    "dev": "next dev --port 3030",
    "dev:keep": "next dev --port 3030",
    "dev:motion": "NEXT_DIST_DIR=.next-motion next dev --port 3032",
    "build": "next build",
    "_comment_build_verify": "Verificar o build NAO pode usar a mesma pasta do servidor de dev: os dois escrevem em .next, o build troca os pedacos debaixo do dev e ele passa a pedir arquivo que nao existe mais (Cannot find module ./NNNN.js). Use este quando so quiser saber se compila.",
    "build:verify": "NEXT_DIST_DIR=.next-verify next build",
    "start": "next start --port 3030",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:refs:promotion-artifacts": "RUN_REFERENCE_PROMOTION_ARTIFACT_TESTS=1 vitest run lib/reference-bank-promotion.artifacts.integration.test.js",
    "e2e:native-motion": "node e2e/native-motion-editing.spec.js",
    "smoke:motion-controls": "node scripts/smoke-motion-controls.mjs",
    "gosto:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-house-style.mjs",
    "refs:migrate": "node scripts/reference-bank/migrate.mjs",
    "refs:migrate:isolated": "node scripts/reference-bank/migrate.mjs --isolated",
    "refs:import": "node scripts/reference-bank/import-seed.mjs",
    "refs:import:isolated": "node scripts/reference-bank/import-seed.mjs --isolated",
    "refs:proof:import:isolated": "node scripts/reference-bank/import-proof.mjs --isolated --seed ../../.firecrawl/reference-proof/reference-bank.proof.seed.json",
    "refs:incremental:import:isolated": "node scripts/reference-bank/import-proof.mjs --isolated --seed ../../.firecrawl/reference-increment-1/reference-bank.increment.seed.json",
    "refs:landbook:import:isolated": "bun scripts/reference-bank/import-proof.mjs --isolated --seed ../../.firecrawl/reference-landbook-pilot/reference-bank.landbook.seed.json",
    "refs:landbook:query:isolated": "bun scripts/reference-bank/query-landbook-pilot.mjs --isolated --seed ../../.firecrawl/reference-landbook-pilot/reference-bank.landbook.seed.json",
    "refs:landbook:pages-6-10:import:isolated": "bun scripts/reference-bank/import-proof.mjs --isolated --seed ../../.firecrawl/reference-landbook-pages-6-10/reference-bank.landbook-pages-6-10.seed.json",
    "refs:landbook:pages-6-10:query:isolated": "bun scripts/reference-bank/query-landbook-pilot.mjs --isolated --seed ../../.firecrawl/reference-landbook-pages-6-10/reference-bank.landbook-pages-6-10.seed.json",
    "refs:promotion:plan": "node scripts/reference-bank/promote-reviewed-delta.mjs --offline-plan",
    "refs:promotion:preflight:isolated": "node scripts/reference-bank/promote-reviewed-delta.mjs --isolated-preflight",
    "refs:promotion:apply:isolated": "node scripts/reference-bank/promote-reviewed-delta.mjs --isolated-apply",
    "refs:promotion:preflight:shared": "node scripts/reference-bank/promote-reviewed-delta.mjs --shared-preflight",
    "refs:promotion:apply:shared": "node scripts/reference-bank/promote-reviewed-delta.mjs --shared-apply",
    "refs:promotion:prove:isolated": "node scripts/reference-bank/prove-reviewed-delta.mjs",
    "refs:rate-source:isolated": "node scripts/reference-bank/rate-aggregator.mjs --isolated",
    "refs:rate-source:shared": "node scripts/reference-bank/rate-aggregator.mjs --shared",
    "evals:gen": "node evals/gen-prompt.mjs",
    "evals": "node evals/gen-prompt.mjs && promptfoo eval -c evals/promptfooconfig.yaml",
    "evals:view": "promptfoo view",
    "evals:rubric": "node evals/anti-slop/build-rubric.mjs",
    "evals:rubric:check": "node evals/anti-slop/build-rubric.mjs --check"
  },
  "dependencies": {
    "@next/env": "15.5.15",
    "@anthropic-ai/sdk": "latest",
    "@google/genai": "latest",
    "@neondatabase/serverless": "^0.10",
    "@uncraft/editor-core": "*",
    "@upstash/redis": "^1.34",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.2",
    "langfuse": "^3.38.20",
    "linkedom": "^0.18.0",
    "lucide-react": "1.24.0",
    "next": "^15",
    "openai": "^6.37.0",
    "opossum": "^9.0.0",
    "playwright-core": "^1.50.0",
    "react": "^19",
    "react-dom": "^19",
    "react-zoom-pan-pinch": "^3.6.0",
    "stripe": "^17",
    "@uncraft/design-eval": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "promptfoo": "^0.121.15",
    "tailwindcss": "^4.3.0",
    "vitest": "^4.1.7"
  }
}
