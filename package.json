{
  "name": "uncraft-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Uncraft monorepo — design tool for the web. Chrome extension + Web canvas SaaS sharing a single editor-core.",
  "workspaces": [
    "packages/editor-core",
    "packages/extension-shell",
    "packages/web-shell"
  ],
  "scripts": {
    "build:editor": "bash scripts/build-editor.sh",
    "build:ext": "bash scripts/build-editor.sh",
    "dev:web": "npm run build:editor && npm run dev --workspace=@uncraft/web-shell",
    "build:web": "npm run build:editor && npm run build --workspace=@uncraft/web-shell",
    "start:web": "npm run start --workspace=@uncraft/web-shell",
    "refs:proof:collect": "node scripts/reference-bank/collect-two-source-proof.mjs",
    "refs:proof:build": "node scripts/reference-bank/build-two-source-proof.mjs",
    "refs:incremental:collect": "node scripts/reference-bank/collect-two-source-increment.mjs",
    "refs:incremental:build": "node scripts/reference-bank/build-two-source-increment.mjs",
    "refs:landbook:collect": "node scripts/reference-bank/collect-landbook-pilot.mjs",
    "refs:landbook:build": "node scripts/reference-bank/build-landbook-pilot.mjs",
    "refs:landbook:pages-6-10:freeze": "node scripts/reference-bank/collect-landbook-pilot.mjs --slice=pages-6-10 --freeze-only",
    "refs:landbook:pages-6-10:collect": "node scripts/reference-bank/collect-landbook-pilot.mjs --slice=pages-6-10",
    "refs:landbook:pages-6-10:build": "node scripts/reference-bank/build-landbook-pilot.mjs --slice=pages-6-10",
    "refs:experiment:manifest:validate": "node scripts/start-from-ref/validate-experiment-manifest.mjs",
    "refs:experiment:references:validate": "node scripts/start-from-ref/validate-experiment-reference-bundles.mjs",
    "refs:experiment:v2:manifest:validate": "node scripts/start-from-ref/validate-clone-first-v2-manifest.mjs",
    "refs:experiment:v2:references:validate": "node scripts/start-from-ref/validate-clone-first-v2-reference-bundles.mjs"
  }
}
